{
  "manifest_version": 3,
  "name": "LingoEx - Yapay Zekâ ile İngilizce Öğren",
  "version": "2.1.1",
  "description": "İnternette gezinirken yapay zekâ asistanın ile İngilizce öğren! Anında sözlük, sesli anlatım ve akıllı pratik kartları.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "idle",
    "contextMenus",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.mymemory.translated.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LingoEx",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "audio/remedial/*.mp3",
        "audio/remedial_questions/*.mp3",
        "audio/assistant/*.mp3"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "trigger-question": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Show a recall prompt immediately without waiting"
    },
    "trigger-page-quiz": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Highlight a sentence on the current page and quiz its translation"
    },
    "trigger-listening-quiz": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Play an English sentence by audio and type what you heard"
    }
  }
}
